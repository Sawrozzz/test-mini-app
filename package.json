{
  "name": "remote-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002 --host",
    "build": "biome check --error-on-warnings --max-diagnostics=200 . && tsc -b && vite build",
    "build:test": "tsc -b && vite build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint:fix": "npm run lint && npm run check",
    "preview": "vite preview --port 3002"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "innxt-shared-ui": "^1.0.6",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@lizuz/mini-app-types": "1.1.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "~7.0.2",
    "vite": "^8.1.5"
  }
}
